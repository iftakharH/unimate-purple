# =============================================================================
# Unimate — environment template. Copy to `.env.local` and fill in values.
# =============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable or anon key>

# Server-only (route handlers / server actions ONLY). Never prefix with
# NEXT_PUBLIC_ and never import it into client components.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# --- Access rules -------------------------------------------------------------
# Comma-separated. These accounts are automatically promoted to `admin` on
# first signup and can never be demoted or deleted by other admins.
SUPER_ADMIN_EMAILS=ihrafi02ctg@gmail.com,242016312@eastdelta.edu.bd

# Only emails on this domain may self-register (super admins excepted).
ALLOWED_EMAIL_DOMAIN=eastdelta.edu.bd

# --- App ----------------------------------------------------------------------
# Public base URL (used in email redirect links). Localhost in dev, the Vercel
# domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows the "Sandbox" badge on the mock checkout. Keep `true` unless a real
# payment gateway is integrated, so nobody believes real money was charged.
NEXT_PUBLIC_SHOW_SANDBOX_BADGE=true

NEXT_PUBLIC_CURRENCY=BDT
